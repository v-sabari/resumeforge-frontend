# ════════════════════════════════════════════════════
#  ResumeForge AI — Frontend Environment Variables
#  Copy to .env and fill in your real values.
#  Never commit your actual .env file.
# ════════════════════════════════════════════════════

# ── Backend API URL ──────────────────────────────────
# No trailing slash. Use http://localhost:8080 for local dev.
VITE_API_BASE_URL=http://localhost:8080

# ── App name ─────────────────────────────────────────
VITE_APP_NAME=ResumeForge AI

# ── Razorpay ─────────────────────────────────────────
# Public key ID only — never put your secret key in the frontend.
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
VITE_RAZORPAY_LINK=https://rzp.io/rzp/your_payment_link

# ── Google Analytics 4 ───────────────────────────────
# Get from: GA4 → Admin → Data Streams → Measurement ID
# Format: G-XXXXXXXXXX
VITE_GA4_ID=G-XXXXXXXXXX

# ── Google AdSense ────────────────────────────────────
# Only add after AdSense approval. Format: ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_CLIENT=ca-pub-0000000000000000
# Ad slot IDs — get from AdSense → Ads → Ad units
VITE_ADSENSE_SLOT_CONTENT=0000000000
